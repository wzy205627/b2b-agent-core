# ==========================================
# B2B 智能提单与防资损风控系统 - 环境变量配置模板
# 复制本文件为 .env 并填入实际值即可运行
# ==========================================

# 1. LangSmith Tracing 可观测性配置 (可选)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=b2b-agent-core

# 2. 阿里云百炼大模型 API 配置 (必填)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_NAME=qwen3.8-flash
DASHSCOPE_BACKUP_MODEL_NAME=qwen3.7-flash-2026-07-15

# 3. 数据库连接配置 (默认对接本地 Docker Postgres)
POSTGRES_URI=postgresql://postgres:1234@localhost:5432/langgraph_db
